# ═══════════════════════════════════════
# XENEA Token & Staking Config
# ═══════════════════════════════════════

# Private key wallet kamu (TANPA 0x prefix)
PRIVATE_KEY=your_private_key_here

# Token addresses yang di-stake (WAJIB untuk deploy staking)
TOKEN_A=0x0000000000000000000000000000000000000123
TOKEN_B=0x0000000000000000000000000000000000000123

# (Optional) Kalau XENEA sudah di-deploy, isi address-nya biar gak deploy ulang
# XENEA_TOKEN=0x...

# (Optional) Jumlah XENEA untuk reward pool (default: 100,000,000)
# REWARD_AMOUNT=100000000
