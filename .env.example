# ═══════════════════════════════════════
# XENEA Token & Staking Config
# ═══════════════════════════════════════

# Private key wallet kamu (TANPA 0x prefix)
PRIVATE_KEY=your_private_key_here

# ── Token A & B ──
# Kosongkan = otomatis deploy MockToken baru
# Isi = pakai token yang sudah ada
# TOKEN_A=0x...
# TOKEN_B=0x...

# Nama & symbol untuk MockToken (kalau deploy baru)
TOKEN_A_NAME=Token A
TOKEN_A_SYMBOL=TKA
TOKEN_B_NAME=Token B
TOKEN_B_SYMBOL=TKB

# ── XENEA Token ──
# Kosongkan = deploy XENEA baru
# XENEA_TOKEN=0x...

# ── Staking ──
# Kosongkan = deploy staking baru
# STAKING_CONTRACT=0x...

# Jumlah XENEA untuk reward pool (default: 100,000,000)
# REWARD_AMOUNT=100000000
